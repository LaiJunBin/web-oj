{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "pnpm gen:api-client",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "gen:mocks": "node msw-auto-mock/dist/cli.js ./src/api/openapi.yaml -o ./src/mocks",
    "gen:api-client": "node openapi-zod-client/lib/cli/bundle/index.cjs ./src/api/openapi.yaml -t ./src/api/template.hbs -o ./src/api/gen  --group-strategy=tag-file --export-types"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@zodios/core": "^10.9.6",
    "axios": "^1.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "^0.48.4",
    "flowbite-svelte-icons": "^2.0.2",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "zod": "^3.24.2"
  },
  "dependencies": {
    "@types/event-source-polyfill": "^1.0.5",
    "ansi_up": "^6.0.5",
    "dompurify": "^3.4.15",
    "event-source-polyfill": "^1.0.31",
    "sweetalert2": "^11.17.2"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  }
}